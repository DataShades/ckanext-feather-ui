{
  "name": "ckanext-feather-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:feather && npm run build:themes",
    "build:feather": "tailwindcss -i ckanext/feather_ui/theme/assets/src/feather.css -o ckanext/feather_ui/theme/assets/feather.css --minify",
    "build:themes": "tailwindcss -i ckanext/feather_ui/theme/assets/src/themes.css -o ckanext/feather_ui/theme/assets/themes.css --minify",
    "watch": "tailwindcss -i ckanext/feather_ui/theme/assets/src/feather.css -o ckanext/feather_ui/theme/assets/feather.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify/tailwind4": "^1.0.0",
    "@tailwindcss/cli": "^4.1.11",
    "daisyui": "^5.0.50",
    "tailwindcss": "^4.1.11"
  }
}
